        "jsCode": "const staticDataNode = $('Extract from File').all();\n\nlet oldProcessedIds = [];\n\nif (staticDataNode.length > 0 && staticDataNode[0].json.data.length > 0 && staticDataNode[0].json.data[0].processedIds) {\n  oldProcessedIds = staticDataNode[0].json.data[0].processedIds;\n}\n\nconst newlyProcessedItems = $('Split Out').all();\nconst newProcessedIds = newlyProcessedItems.map(item => item.json.id);\n\nconst allProcessedIds = [...new Set([...oldProcessedIds, ...newProcessedIds])];\n\nreturn {\n  processedIds: allProcessedIds\n};"
      },
