      "parameters": {
        "jsCode": "const item = $input.first();\nlet processedIds = [];\n\nif (item.binary?.data?.data) {\n  try {\n    const decoded = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n    const parsed = JSON.parse(decoded);\n    if (Array.isArray(parsed?.data) && parsed.data[0]?.processedIds) {\n      processedIds = parsed.data[0].processedIds;\n    } else if (Array.isArray(parsed?.processedIds)) {\n      processedIds = parsed.processedIds;\n    }\n  } catch {\n    processedIds = [];\n  }\n}\n\nreturn [{ data: [{ processedIds }] }];"
      },
