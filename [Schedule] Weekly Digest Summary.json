      "parameters": {
        "jsCode": "const newArticles = $input.first().json.itemRefs || [];\n\nconst staticDataNode = $('Extract from File').all();\n\nlet processedIds = [];\n\nif (staticDataNode.length > 0 && staticDataNode[0]?.json?.data?.length > 0 && staticDataNode[0].json.data[0].processedIds) {\n  processedIds = staticDataNode[0].json.data[0].processedIds;\n}\n\nconst processedIdSet = new Set(processedIds);\n\nconst articlesToProcess = newArticles.filter(article => !processedIdSet.has(article.id));\n\nreturn articlesToProcess;"
