        "messages": {
          "values": [
            {
              "content": "=Podsumuj artykuł po polsku i angielsku. Oczekiwany JSON:\n{\n  \"pl\": { \"title\": \"...\", \"description\": \"jedno zdanie\", \"summary\": \"3-4 zdania\", \"tags\": [\"tag1\", \"tag2\"] },\n  \"en\": { \"title\": \"...\", \"description\": \"one sentence\", \"summary\": \"3-4 sentences\", \"tags\": [\"tag1\", \"tag2\"] },\n  \"original_link\": \"...\"\n}\nTagi: małe litery, po angielsku, bez polskich znaków.\n\nTytuł: {{ $('Split Out1').item.json.title }}\nLink: {{ $('Split Out1').item.json.canonical[0].href }}\nTreść:\n{{ $('Split Out1').item.json.summary.content }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        2032,
        16
      ],
      "id": "89d46c09-d649-49bb-8d2b-39c10f52db53",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "KX1kCoQjtGtFHtAh",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiResponses = $input.all();\nconst date = new Date().toISOString().split('T')[0];\n\nconst articles = aiResponses.map(item => {\n  const raw = item.json.content?.parts?.[0]?.text ?? item.json.text ?? item.json;\n  try {\n    return typeof raw === 'string' ? JSON.parse(raw) : raw;\n  } catch {\n    return null;\n  }\n}).filter(Boolean);\n\nconst featured = articles.slice(0, 5);\nconst extra = articles.slice(5);\n\nfunction buildBody(lang) {\n  const mainSection = featured.map(a => {\n    const l = a[lang];\n    return `## ${l.title}\\n\\n${l.summary}\\n\\n[${lang === 'pl' ? 'Oryginalny artyku\\u0142' : 'Original article'}](${a.original_link})\\n\\n---\\n\\n`;\n  }).join('');\n\n  if (extra.length === 0) return mainSection;\n\n  const extraHeading = lang === 'pl' ? '## Materia\\u0142y dodatkowe' : '## Additional materials';\n  const extraList = extra.map(a => {\n    const l = a[lang];\n    return `- [${l.title}](${a.original_link}) \\u2014 ${l.description}`;\n  }).join('\\n');\n\n  return `${mainSection}${extraHeading}\\n\\n${extraList}\\n`;\n}\n\nfunction buildFile(lang, titleStr, descStr, introStr) {\n  const tags = [...new Set(articles.flatMap(a => (a[lang]?.tags ?? [])))].slice(0, 5);\n  const tagsYaml = tags.map(t => `  - ${t}`).join('\\n');\n  const slug = `${date}-weekly-digest-${lang}`;\n  return [\n    '---',\n    `title: \"${titleStr}\"`,\n    `description: \"${descStr}\"`,\n    `date: \"${date}\"`,\n    `tags:\\n${tagsYaml}`,\n    `slug: \"${slug}\"`,\n    'featured: false',\n    'draft: true',\n    '---',\n    '',\n    introStr,\n    '',\n    '---',\n    '',\n    buildBody(lang),\n  ].join('\\n');\n}\n\nconst plFile = buildFile(\n  'pl',\n  `Tygodniowy Przegl\\u0105d - ${date}`,\n  'M\\u00f3j cotygodniowy przegl\\u0105d artyku\\u0142\\u00f3w z RSS.',\n  'Oto artyku\\u0142y, kt\\u00f3re przyku\\u0142y moj\\u0105 uwag\\u0119 w tym tygodniu. Mi\\u0142ej lektury!'\n);\n\nconst enFile = buildFile(\n  'en',\n  `Weekly Digest - ${date}`,\n  'My weekly digest of articles from RSS.',\n  'Here are the articles that caught my eye this week. Enjoy!'\n);\n\nreturn [\n  { fileName: `${date}-weekly-digest-pl.md`, fileContent: plFile },\n  { fileName: `${date}-weekly-digest-en.md`, fileContent: enFile },\n];"
      },
